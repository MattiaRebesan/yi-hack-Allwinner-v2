#!/bin/sh

CONF_FILE="etc/system.conf"

YI_HACK_PREFIX="/tmp/sd/yi-hack"

get_config()
{
    key=$1
    grep $1 $YI_HACK_PREFIX/$CONF_FILE | cut -d "=" -f2
}

if [[ $(get_config DISABLE_CLOUD) == "yes" ]] ; then
    $YI_HACK_PREFIX/bin/cloudAPI_fake "$@"
else
    $YI_HACK_PREFIX/bin/cloudAPI_real "$@"
fi
