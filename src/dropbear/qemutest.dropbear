
set -e

LIBMAIN_PATH=/opt/yi/toolchain-sunxi-musl/toolchain

# Capture instead of piping straight into grep. A pipe hides why the binary
# would not run, which matters now that dropbear is built PIE + RELRO +
# fortified and qemu-arm-static has to load an ET_DYN executable.
file ./_install/dropbearmulti || true
OUT=$(qemu-arm-static -L $LIBMAIN_PATH -E LD_LIBRARY_PATH=./_install/lib/ ./_install/dropbearmulti -h 2>&1 || true)
printf '%s\n' "$OUT"
printf '%s\n' "$OUT" | grep 'Dropbear SSH multi-purpose'