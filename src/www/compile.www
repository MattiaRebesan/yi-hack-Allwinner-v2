#!/bin/sh

compress_html()
{
    local SRC=$1
    local DST=$2

    echo "Compressing $SRC..."
    awk -f ./httpd/tools/remcomm.awk "$SRC" > ./_install/www/tmp.html
    # libxml's HTML parser predates HTML5, so it prints "Tag section invalid"
    # and friends for header/nav/main/section/details/summary/datalist. It
    # still exits 0 and still copies those elements through verbatim - tag,
    # attribute and id inventories were diffed and match. Warnings only.
    xmllint --html --noblanks ./_install/www/tmp.html > "$DST"
    rm ./_install/www/tmp.html
}

set -e

SCRIPT_DIR=$(cd `dirname $0` && pwd)
cd $SCRIPT_DIR

mkdir -p ./_install/www/cgi-bin
mkdir -p ./_install/www/img
mkdir -p ./_install/www/css
mkdir -p ./_install/www/js

echo "Compressing CSS files..."
yui-compressor --type css -o ./_install/www/css/all.css ./httpd/htdocs/css/custom.css

# yui-compressor is Rhino-based and rejects ES6. Both files are ES5 for that
# reason; a stray arrow function fails the build here and nowhere else.
echo "Compressing JS files..."
cat ./httpd/htdocs/js/dom.js ./httpd/htdocs/js/app.js > ./_install/www/js/tmp.js
yui-compressor -v --type js -o ./_install/www/js/all.js ./_install/www/js/tmp.js
rm ./_install/www/js/tmp.js

echo "Compressing HTML files..."

compress_html ./httpd/htdocs/index.html ./_install/www/index.html

echo "Copying the timezone table..."
cp ./httpd/htdocs/tz.json ./_install/www/tz.json

echo "Copying image files..."
cp -R ./httpd/htdocs/img/. ./_install/www/img/

# To exlude more directories add the following line to the find command (after "-type f")
# -not \( -path './_install/www/DIRECTORY_NAME/*' -prune \)
echo "Aplying GZIP Compression to files..."
find ./_install/www/* -type f -not \( -path './_install/www/cgi-bin/*' -prune \) -exec gzip -f -9 {} +

echo "Copying the cgi-bin folder..."
cp ./httpd/cgi-bin/* ./_install/www/cgi-bin

echo "Compilation succeeded."
